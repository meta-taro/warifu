#!/usr/bin/env bash
# **push の前に、置き場所を見る**（全 OSS で同じ形）。
#
# 公開リポジトリは、push した時点で履歴に残る。commit の前（pre-commit）でも同じ検査が走るが、
# 別の手で commit されたものもここで止める。**--no-verify で外さない。**
set -u
here="$(git rev-parse --show-toplevel)"
printf '  %-38s' "置き場所"
bash "$here/.github/scripts/oss-placement-check.sh" || exit 1
# 共通の検査と重ならない分（語と、.claude/ の外の記録の置き場所）。送る版の木を見る
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  printf '  %-38s' "公開しない語（${local_ref}）"
  bash "$here/scripts/check-public-words.sh" "$local_sha" || exit 1
done
