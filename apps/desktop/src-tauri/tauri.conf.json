{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "warifu",
  "version": "0.1.2",
  "identifier": "app.warifu.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "warifu",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["warifu"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/meta-taro/warifu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGODlCNjY1NkM0NzFDNDAKUldSQUhFZHNaYmFKUDFjV2VWcytPLzVHbUFYYnBYb0haZ29HS1U3VkNOSFJYekJJakVCWUQvZEoK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
