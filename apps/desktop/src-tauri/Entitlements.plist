<?xml version="1.0" encoding="UTF-8"?>
<!--
  署名するときの権限（macOS）。

  **いま（ad-hoc 署名）は無くても動く。**要るのは配布のために公証したときで、
  公証には hardened runtime が必須になり、**そこでは entitlements が無いと
  カメラもマイクも動かなくなる。**「配ろうとした日に気づく」形の壊れ方なので、先に置く。

  **最小限にする。**ここに書いたものは「このアプリが要求してよい権限」であって、
  多く書くほど、審査でも読む人にとっても説明が要る。
-->
<plist version="1.0">
  <dict>
    <!-- 会議で自分の映像と声を送るため -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- 相手へ繋ぎに行く／相手から繋がれる。**両方要る**（呼ぶ側と待つ側の両方をやる） -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
  </dict>
</plist>
