# warifu 環境変数のひな型
# 実際の値は .env に記載し、.env はコミットしないこと。
#
# baseline §14: AI は秘密情報を作らない・置かない・貼らない。
# **このファイルには変数名だけを書く。**
#
#   cp .env.example .env    ← そのうえで、自分で値を入れる

# --- 受信箱（warifu-imap / issues/007 の R5） ---
# Gmail などは通常のパスワードでは入れない。アプリ用のパスワードを発行して使うこと。

WARIFU_IMAP_HOST=
WARIFU_IMAP_PORT=
WARIFU_IMAP_USER=
WARIFU_IMAP_PASSWORD=

# 1 回に取り込む上限（省略時 50）
WARIFU_IMAP_LIMIT=

# 会計を書き足す先（省略時 warifu-ledger.tsv）
WARIFU_LEDGER=
